<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="A.SiteMaster" %>
<!DOCTYPE html>
<html lang="es">
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - AMET Gestión</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <link href="/Content/Site.css" rel="stylesheet" type="text/css" />
    <link href="/Content/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="/Content/dataTables.bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />
    <script type="text/javascript" src="../Scripts/script.js"></script>
    <script type="text/javascript" src="../Scripts/jquery-1.9.1.min.js"></script>
    <script type="text/javascript" src="../Scripts/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="../Scripts/dataTables.bootstrap.min.js"></script>
    <script type="text/javascript" src="../Scripts/dataTables.buttons.min.js"></script>
    <script type="text/javascript" src="../Scripts/buttons.bootstrap.min.js"></script>
    <script type="text/javascript" src="../Scripts/jszip.min.js"></script>
    <script type="text/javascript" src="../Scripts/pdfmake.min.js"></script>
    <script type="text/javascript" src="../Scripts/vfs_fonts.js"></script>
    <script type="text/javascript" src="../Scripts/buttons.html5.min.js"></script>
    <script type="text/javascript" src="../Scripts/buttons.print.min.js"></script>
    <script type="text/javascript" src="../Scripts/buttons.colVis.min.js"></script>
    <asp:ContentPlaceHolder ID="HeadContent" runat="server"></asp:ContentPlaceHolder>
    
</head>
<body>
    <style type="text/css">
        .FondoCSS {
            background-color: <%= ConfigurationManager.AppSettings["FondoCSS"] %>;
        }
    </style>
    <form runat="server">
        <asp:ScriptManager runat="server" EnableScriptGlobalization="true">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Path="/Scripts/WebForms/MSAjax/MicrosoftAjax.js" />
                <asp:ScriptReference Path="/Scripts/WebForms/MSAjax/MicrosoftAjaxApplicationServices.js" />
                <asp:ScriptReference Path="/Scripts/WebForms/MSAjax/MicrosoftAjaxTimer.js" />
                <asp:ScriptReference Path="/Scripts/WebForms/MSAjax/MicrosoftAjaxWebForms.js" />
                <asp:ScriptReference Path="/Scripts/bootstrap.js" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="/Scripts/WebForms/Focus.js" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>
        
        <div class="navbar navbar-inverse navbar-fixed-top FondoCSS">
            <div class="container">
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle" data-toggle="collapse" data-target=".navbar-collapse">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    <a class="navbar-brand" runat="server" href="~/Inicio/Default.aspx">AMET San Juan | </a>
                </div>
                <div class="navbar-collapse collapse">
                    <ul class="nav navbar-nav">
                       <li><asp:LinkButton ID="Bt_Ordenes"  runat="server" PostBackUrl="~/ABMs/Ordenes.aspx">Ordenes</asp:LinkButton></li>
                        <li><asp:LinkButton ID="Bt_Afiliados"  runat="server" PostBackUrl="~/ABMs/Afiliados.aspx">Afiliados</asp:LinkButton></li>
                        

                         <li class="dropdown">
                            <asp:LinkButton ID="BT_ListadoReportes" data-toggle="dropdown" class="nav-link dropdown-toggle" runat="server">Reportes<span class="caret"></span></asp:LinkButton>
                            <ul class="dropdown-menu">
                              <li><asp:LinkButton ID="BT_ReportesGenerales" class="dropdown-item" runat="server" PostBackUrl="~/Reportes/Reportes.aspx">&raquo; Reportes Generales</asp:LinkButton></li>
                              <li><asp:LinkButton ID="BT_ReportesEjecutivos" class="dropdown-item" runat="server" PostBackUrl="~/ReportesEjecutivos/ReportesEjecutivos.aspx">&raquo; Reportes Ejecutivos</asp:LinkButton></li>                              
                            </ul>
                        </li>

                        <li><asp:LinkButton ID="Bt_liquidaciones"  runat="server" PostBackUrl="~/ABMs/Liquidaciones.aspx">Liquidaciones</asp:LinkButton></li>
                        <li class="dropdown">
                            <asp:LinkButton ID="Bt_Administrar" data-toggle="dropdown" class="nav-link dropdown-toggle" runat="server">Administrar<span class="caret"></span></asp:LinkButton>
                            <ul class="dropdown-menu">
                              <li><asp:LinkButton ID="Bt_Personas" class="dropdown-item" runat="server" PostBackUrl="~/Administracion/Personas.aspx">&raquo; Personas</asp:LinkButton></li>
                              <li><asp:LinkButton ID="Bt_Comercios" class="dropdown-item" runat="server" PostBackUrl="~/Administracion/Comercios.aspx" Visible="<%# AMET.PermisoAdministracion() %>">&raquo; Comercios</asp:LinkButton></li>
                              <li><asp:LinkButton ID="Bt_OS" class="dropdown-item" runat="server" PostBackUrl="~/Administracion/ObraSocial.aspx"  Visible="<%# AMET.PermisoAdministracion() %>">&raquo; Obra Social</asp:LinkButton></li>
                              <li><asp:LinkButton ID="Bt_Coseguro" class="dropdown-item" runat="server" PostBackUrl="~/Administracion/Coseguro.aspx" Visible="<%# AMET.PermisoAdministracion() %>">&raquo; Coseguro</asp:LinkButton></li>
                              <li><asp:LinkButton ID="Bt_Centro"  class="dropdown-item" runat="server" PostBackUrl="~/Administracion/Centro.aspx" Visible="<%# AMET.PermisoAdministracion() %>">&raquo; Centro</asp:LinkButton></li>
                              <li><asp:LinkButton ID="Bt_Sector" class="dropdown-item" runat="server" PostBackUrl="~/Administracion/Sector.aspx" Visible="<%# AMET.PermisoAdministracion() %>">&raquo; Sector</asp:LinkButton></li>
                              <li><asp:LinkButton ID="Bt_Clase"  class="dropdown-item" runat="server" PostBackUrl="~/Administracion/Clase.aspx" Visible="<%# AMET.PermisoAdministracion() %>">&raquo; Clase</asp:LinkButton></li>
                            </ul>
                        </li>
                        <li class="dropdown">
                            <asp:LinkButton ID="Bt_Seguridad" data-toggle="dropdown" class="nav-link dropdown-toggle" runat="server">Seguridad<span class="caret"></span></asp:LinkButton>
                            <ul class="dropdown-menu">
                              <li><asp:LinkButton ID="Bt_Usuarios"  class="dropdown-item" runat="server" PostBackUrl="~/Administracion/Usuarios.aspx">&raquo; Usuarios del Sistema</asp:LinkButton></li>
                              <li><asp:LinkButton ID="Bt_Permisos"  class="dropdown-item" runat="server" PostBackUrl="~/Administracion/Permisos.aspx">&raquo; Permisos de Usuarios</asp:LinkButton></li>
                            </ul>
                        </li>
                    </ul>
                    <asp:LoginView runat="server" ViewStateMode="Disabled">
                        <AnonymousTemplate>
                            <ul class="nav navbar-nav navbar-right">
                                <li><a runat="server" href="~/Account/Login">Iniciar sesión</a></li>
                            </ul>
                        </AnonymousTemplate>
                        <LoggedInTemplate>
                            <ul class="nav navbar-nav navbar-right">
                                <li class="dropdown">
                                    <asp:LinkButton ID="Bt_Perfil" data-toggle="dropdown" class="nav-link dropdown-toggle" runat="server">(<asp:LoginName ID="LoginName1" runat="server" />)</asp:LinkButton>
                                    <ul class="dropdown-menu">
                                      <li><asp:LinkButton ID="Bt_Contraseña"  class="dropdown-item" runat="server" PostBackUrl="~/Account/ChangePassword">&raquo; Cambiar Contraseña</asp:LinkButton></li>
                                      
                                    </ul>
                                </li>
                                
                                 <li><asp:LoginStatus ID="HeadLoginStatus" runat="server" LogoutAction="Redirect" LogoutText="Salir" LogoutPageUrl="~/Inicio/Default.aspx"/></li>
                            </ul>
                        </LoggedInTemplate>
                    </asp:LoginView>
                </div>
            </div>
        </div>
        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
            <hr />
            <footer align="center">
                <p>&copy; <%: DateTime.Now.Year %> - Creado por <a href="mailto:consultora@gmail.com">UOAC technology</a></p>
            </footer>
        </div>
    </form>
</body>
</html>
