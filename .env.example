# Generate a unique strong value. Do not reuse or commit a real password.
MSSQL_SA_PASSWORD=replace-with-a-strong-local-password

# SQL Server 2022 is the production/Coolify default. Apple Silicon local runs
# can use mcr.microsoft.com/azure-sql-edge:latest as a temporary ARM64 option.
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2022-latest
DB_BACKUP_PATH=../BD_AMET/20260819_BK_A.bak
APP_PORT=8080
